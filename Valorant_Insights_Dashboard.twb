      <aliases enabled='yes' />
      <column caption='Agent Diversity Buckets' datatype='string' name='[Calculation_589971566039859202]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [avg_agent_diversity] &lt;= 2 THEN&#13;&#10;    &apos;1-2 agents (one-trick)&apos;&#13;&#10;&#13;&#10;ELSEIF [avg_agent_diversity] &lt;= 5 THEN&#13;&#10;    &apos;3-5 agents (flexible)&apos;&#13;&#10;&#13;&#10;ELSEIF [avg_agent_diversity] &lt;= 9 THEN&#13;&#10;    &apos;6-9 agents (experimental)&apos;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &apos;10+ agents (explorer)&apos;&#13;&#10;END' />
      </column>
      <column caption='Customer Segmentation' datatype='string' name='[Calculation_589971566044069892]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([recency_days]) THEN &apos;Non-Spender&apos;&#13;&#10;ELSEIF [recency_days] &lt;= 90 THEN &apos;Active (&lt; 90 days)&apos;&#13;&#10;ELSEIF [recency_days] &lt;= 180 THEN &apos;Lapsing (90-180 days)&apos;&#13;&#10;ELSEIF [recency_days] &lt;= 365 THEN &apos;At Risk (180-365 days)&apos;&#13;&#10;ELSE &apos;Churned (365+ days)&apos;&#13;&#10;END' />
      </column>
      <column caption='Rank Buckets' datatype='string' name='[Calculation_589971566049189895]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [avg_rank_score] &gt;= 6 THEN &apos;High Rank (Diamond+)&apos;&#13;&#10;ELSEIF [avg_rank_score] &gt;= 4 THEN &apos;Mid Rank (Gold-Platinum)&apos;&#13;&#10;ELSE &apos;Low Rank (Iron-Silver)&apos;&#13;&#10;END' />
      </column>
      <column caption='Session Duration Buckets' datatype='string' name='[Calculation_589971566049267720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [avg_session_mins] &gt;= 60 THEN &apos;Long Sessions (60+ min)&apos;&#13;&#10;ELSEIF [avg_session_mins] &gt;= 40 THEN &apos;Medium Sessions (40-60 min)&apos;&#13;&#10;ELSE &apos;Short Sessions (&lt; 40 min)&apos;&#13;&#10;END' />
      </column>
      <column caption='Rank Bucket Order' datatype='integer' name='[Calculation_589971566054309898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_589971566049189895]&#13;&#10;WHEN &apos;High Rank (Diamond+)&apos; THEN 3&#13;&#10;WHEN &apos;Mid Rank (Gold-Platinum)&apos; THEN 2&#13;&#10;WHEN &apos;Low Rank (Iron-Silver)&apos; THEN 1&#13;&#10;END' />
      </column>
