                <formatted-text>
                  <run fontcolor='#ff4655' fontname='Copperplate Gothic Bold' fontsize='20'>■</run>
                  <run fontcolor='#000000' fontname='Copperplate Gothic Bold' fontsize='14'>Æ </run>
                  <run fontcolor='#f5f5f5' fontname='Copperplate Gothic Bold' fontsize='14'>Area of Interest</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#d9a441' fontname='Copperplate Gothic Bold' fontsize='20'>■</run>
                  <run fontcolor='#000000' fontname='Copperplate Gothic Bold' fontsize='14'>Æ </run>
