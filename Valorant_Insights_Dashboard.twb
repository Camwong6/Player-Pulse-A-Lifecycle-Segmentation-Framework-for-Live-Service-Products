                  <run>Æ&#10;</run>
                  <run fontcolor='#b8b0ae' fontname='Copperplate Gothic Bold' fontsize='20'>■</run>
                  <run fontcolor='#000000' fontname='Copperplate Gothic Bold' fontsize='20'>Æ </run>
                  <run fontcolor='#ffffff' fontname='Copperplate Gothic Bold' fontsize='14'>Noise/Context</run>
