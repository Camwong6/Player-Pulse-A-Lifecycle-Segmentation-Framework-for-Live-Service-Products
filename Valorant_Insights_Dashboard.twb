          <datasource-dependencies datasource='federated.1ni0qk10suaipe1bnk30l1nwoi9h'>
            <column caption='SUM([Total Spend]) / SUM([Seasons Active])' datatype='real' name='[Calculation_2079537142864195585]' role='measure' type='quantitative' user:unnamed='&lt;Esports effect x Purchase&gt;'>
              <calculation class='tableau' formula='SUM([total_spend]) / SUM([seasons_active])' />
            </column>
            <column caption='SUM(IF [Has Purchased] = &apos;Yes&apos; THEN 1 ELSE 0 END) / COUNT([Us...' datatype='real' name='[Calculation_2079537142864773123]' role='measure' type='quantitative' user:unnamed='&lt;Esports effect x Purchase&gt;'>
