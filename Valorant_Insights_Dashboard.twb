    <worksheet name='Customer Churn'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#9aa0a6' fontname='Wide Latin' fontsize='20'>Player Segmentation</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Aggregated_combined_data' name='federated.1ni0qk10suaipe1bnk30l1nwoi9h' />
          </datasources>
          <datasource-dependencies datasource='federated.1ni0qk10suaipe1bnk30l1nwoi9h'>
            <column caption='Customer Segmentation' datatype='string' name='[Calculation_589971566044069892]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([recency_days]) THEN &apos;Non-Spender&apos;&#13;&#10;ELSEIF [recency_days] &lt;= 90 THEN &apos;Active (&lt; 90 days)&apos;&#13;&#10;ELSEIF [recency_days] &lt;= 180 THEN &apos;Lapsing (90-180 days)&apos;&#13;&#10;ELSEIF [recency_days] &lt;= 365 THEN &apos;At Risk (180-365 days)&apos;&#13;&#10;ELSE &apos;Churned (365+ days)&apos;&#13;&#10;END' />
            </column>
            <column-instance column='[total_spend]' derivation='Avg' name='[avg:total_spend:qk]' pivot='key' type='quantitative' />
            <column-instance column='[transaction_count]' derivation='Avg' name='[avg:transaction_count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[user_id]' derivation='Count' name='[cnt:user_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_589971566044069892]' derivation='None' name='[none:Calculation_589971566044069892:nk]' pivot='key' type='nominal' />
            <column caption='Recency Days' datatype='real' name='[recency_days]' role='measure' type='quantitative' />
            <column caption='Total Spend' datatype='real' name='[total_spend]' role='measure' type='quantitative' />
            <column caption='Transaction Count' datatype='integer' name='[transaction_count]' role='measure' type='quantitative' />
            <column caption='User Id' datatype='string' name='[user_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <manual-sort column='[federated.1ni0qk10suaipe1bnk30l1nwoi9h].[none:Calculation_589971566044069892:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Active (&lt; 90 days)&quot;</bucket>
              <bucket>&quot;At Risk (180-365 days)&quot;</bucket>
              <bucket>&quot;Churned (365+ days)&quot;</bucket>
              <bucket>&quot;Lapsing (90-180 days)&quot;</bucket>
              <bucket>&quot;Non-Spender&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1ni0qk10suaipe1bnk30l1nwoi9h].[cnt:user_id:qk]' scope='cols' value='Number of Users' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#e9e6e4' />
          </style-rule>
